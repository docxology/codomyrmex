{
  "name": "code-analysis-pipeline",
  "description": "Static analysis, analysis-tool inventory and secret scan of the current directory. Steps cannot consume each other's output ({{step.output}} substitution is not supported), so the former AI-insight and chart steps that depended on it were removed.",
  "steps": [
    {
      "name": "analyze_code",
      "module": "coding.static_analysis",
      "action": "analyze_project",
      "parameters": {
        "project_root": "."
      },
      "dependencies": [],
      "timeout": null,
      "max_retries": 0
    },
    {
      "name": "list_analysis_tools",
      "module": "coding.static_analysis",
      "action": "get_available_tools",
      "parameters": {},
      "dependencies": [],
      "timeout": null,
      "max_retries": 0
    },
    {
      "name": "scan_secrets",
      "module": "security",
      "action": "scan_secrets",
      "parameters": {
        "target_path": "."
      },
      "dependencies": [],
      "timeout": null,
      "max_retries": 0
    }
  ]
}
