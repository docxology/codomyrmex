{
  "name": "basic_analysis",
  "description": "Validate the environment, then run static analysis on the current directory.",
  "steps": [
    {
      "name": "check_env",
      "module": "environment_setup",
      "action": "validate_environment",
      "parameters": {},
      "dependencies": [],
      "timeout": 60,
      "max_retries": 0
    },
    {
      "name": "analyze",
      "module": "coding.static_analysis",
      "action": "analyze_project",
      "parameters": {
        "project_root": "."
      },
      "dependencies": [
        "check_env"
      ],
      "timeout": 300,
      "max_retries": 0
    }
  ]
}
